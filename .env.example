# Gemini API key (only needed by the optional Gemini-powered features).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public Vite environment values. These are visible in the browser bundle.
# Use the Supabase publishable key only. Never use service_role or sb_secret here.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Optional deployment origin used by app-generated links.
APP_URL="https://your-site.example"
